# Copy to secrets.toml (gitignored) for local runs:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Streamlit Cloud: App settings → Secrets → paste AJOS_PASSWORD line.

AJOS_PASSWORD = "change-me-to-your-static-password"

# Optional — contact discovery + email finder (CLI uses export or secrets.toml)
HUNTER_API_KEY = "your-hunter-api-key"
# APOLLO_API_KEY = "your-apollo-api-key"

# Optional: AI company chat — Claude preferred if both keys are set.
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
# ANTHROPIC_MODEL = "claude-haiku-4-5"   # optional override
